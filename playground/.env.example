APP_NAME="playground"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_KEY=playground-key-at-least-32-characters

PORT=3000
HOST=

VIEW_CACHE=false

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_REQUESTS=false

DB_CONNECTION=sqlite
DB_DATABASE=database/playground.sqlite
DB_FOREIGN_KEYS=true

AUTH_MOUNT=true
AUTH_SECRET=playground-auth-secret-at-least-32-chars

CACHE_STORE=file
CACHE_PREFIX=playground_cache_
CACHE_LIMITER=array
REDIS_URL=redis://127.0.0.1:6379
