{
  "name": "@elyvel/core",
  "version": "1.0.0-alpha.1",
  "description": "Core kernel for the Elyvel framework — container, providers, config, and the root router",
  "keywords": [
    "bun",
    "container",
    "elysia",
    "elyvel",
    "framework",
    "middleware",
    "routing",
    "session"
  ],
  "license": "MIT",
  "author": "ufhy",
  "homepage": "https://github.com/ufhy/elyvel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ufhy/elyvel.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@elyvel/contracts": "workspace:*",
    "@elyvel/support": "workspace:*"
  },
  "peerDependencies": {
    "elysia": ">=1.4.0"
  }
}
