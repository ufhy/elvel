{
  "name": "@elvel/vite",
  "version": "1.0.0-alpha.16",
  "description": "The Vite plugin for Elvel \u2014 hot file, server-side reload, build output and asset URLs",
  "keywords": [
    "bun",
    "elvel",
    "hmr",
    "vite",
    "vite-plugin"
  ],
  "license": "MIT",
  "author": "ufhy",
  "homepage": "https://github.com/ufhy/elvel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ufhy/elvel.git",
    "directory": "packages/vite"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=esm --outfile dist/index.js && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vite": ">=6.0.0"
  }
}
