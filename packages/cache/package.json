{
  "name": "@elyvel/cache",
  "version": "1.0.0-alpha.1",
  "description": "Laravel-style cache for Elyvel — repository API, memory, file, database and Redis stores",
  "keywords": [
    "bun",
    "cache",
    "elyvel",
    "lock",
    "mutex",
    "redis"
  ],
  "license": "MIT",
  "author": "ufhy",
  "homepage": "https://github.com/ufhy/elyvel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ufhy/elyvel.git",
    "directory": "packages/cache"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config/*": "./config/*"
  },
  "files": [
    "src",
    "config",
    "stubs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@elyvel/console": "workspace:*",
    "@elyvel/contracts": "workspace:*",
    "@elyvel/core": "workspace:*",
    "@elyvel/database": "workspace:*"
  }
}
