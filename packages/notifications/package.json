{
  "name": "@elvel/notifications",
  "version": "1.0.0-alpha.4",
  "description": "Laravel-style notifications for Elvel — mail, database, broadcast and Telegram channels",
  "keywords": [
    "bun",
    "elvel",
    "notifications",
    "telegram"
  ],
  "license": "MIT",
  "author": "ufhy",
  "homepage": "https://github.com/ufhy/elvel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ufhy/elvel.git",
    "directory": "packages/notifications"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config/*": "./config/*"
  },
  "files": [
    "src",
    "config",
    "stubs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@elvel/console": "workspace:*",
    "@elvel/contracts": "workspace:*",
    "@elvel/core": "workspace:*",
    "@elvel/database": "workspace:*",
    "@elvel/mail": "workspace:*",
    "@elvel/queue": "workspace:*",
    "@elvel/support": "workspace:*"
  }
}
