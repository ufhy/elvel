{
  "name": "@elvel/log",
  "version": "1.0.0-alpha.15",
  "description": "Logging for Elvel — channels, stacks, and levels, mirrors Laravel’s Log",
  "keywords": [
    "bun",
    "channels",
    "elvel",
    "log",
    "logging",
    "monolog"
  ],
  "license": "MIT",
  "author": "ufhy",
  "homepage": "https://github.com/ufhy/elvel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ufhy/elvel.git",
    "directory": "packages/log"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config/*": "./config/*"
  },
  "files": [
    "src",
    "config",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
