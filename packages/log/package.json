{
  "name": "@elyvel/log",
  "version": "1.0.0-alpha.1",
  "description": "Logging for Elyvel — channels, stacks, and levels, mirrors Laravel’s Log",
  "keywords": [
    "bun",
    "channels",
    "elyvel",
    "log",
    "logging",
    "monolog"
  ],
  "license": "MIT",
  "author": "ufhy",
  "homepage": "https://github.com/ufhy/elyvel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ufhy/elyvel.git",
    "directory": "packages/log"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config/*": "./config/*"
  },
  "files": [
    "src",
    "config",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@elyvel/console": "workspace:*",
    "@elyvel/contracts": "workspace:*",
    "@elyvel/core": "workspace:*",
    "@elyvel/support": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "elysia": ">=1.4.0"
  }
}
