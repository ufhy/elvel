{
  "name": "@elvel/spa",
  "version": "1.0.0-alpha.16",
  "description": "The document a client-routed application boots from, and the client that talks to it",
  "keywords": [
    "bun",
    "elvel",
    "spa",
    "vite",
    "csrf"
  ],
  "license": "MIT",
  "author": "ufhy",
  "homepage": "https://github.com/ufhy/elvel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ufhy/elvel.git",
    "directory": "packages/spa"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./config/*": "./config/*",
    "./vue": "./src/vue.ts"
  },
  "files": [
    "src",
    "config",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@elvel/core": "workspace:*",
    "@elvel/http": "workspace:*",
    "@elvel/view": "workspace:*"
  },
  "peerDependencies": {
    "elysia": ">=1.4.0",
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "vue": "^3.5.41"
  }
}
