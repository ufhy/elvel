{
  "name": "@elyvel/database",
  "version": "1.0.0-alpha.1",
  "description": "A Laravel Eloquent-style Active Record ORM for Bun — SQLite, Postgres and MySQL",
  "keywords": [
    "bun",
    "eloquent",
    "elyvel",
    "migrations",
    "mysql",
    "orm",
    "postgres",
    "query-builder",
    "sqlite"
  ],
  "license": "MIT",
  "author": "ufhy",
  "homepage": "https://github.com/ufhy/elyvel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ufhy/elyvel.git",
    "directory": "packages/database"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./stubs/*": "./stubs/*",
    "./config/*": "./config/*"
  },
  "files": [
    "src",
    "config",
    "stubs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@elyvel/console": "workspace:*",
    "@elyvel/contracts": "workspace:*",
    "@elyvel/core": "workspace:*",
    "@elyvel/process": "workspace:*",
    "@elyvel/support": "workspace:*",
    "picocolors": "^1.1.1"
  }
}
