{
  "name": "@elvel/view",
  "version": "1.0.0-alpha.23",
  "description": "Server-rendered views for Elvel — JSX components, layouts, stacks, and Vite assets",
  "keywords": [
    "bun",
    "elvel",
    "html",
    "jsx",
    "template",
    "view",
    "vite"
  ],
  "license": "MIT",
  "author": "ufhy",
  "homepage": "https://github.com/ufhy/elvel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ufhy/elvel.git",
    "directory": "packages/view"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config/*": "./config/*"
  },
  "files": [
    "src",
    "config",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@elysiajs/static": "^1.4.10",
    "@elvel/contracts": "workspace:*",
    "@elvel/core": "workspace:*"
  },
  "peerDependencies": {
    "elysia": ">=1.4.0"
  }
}
