{
  "name": "@elyvel/http",
  "version": "1.0.0-alpha.1",
  "description": "The HTTP layer for Elyvel — middleware, sessions, cookies, CSRF and rate limiting",
  "keywords": [
    "bun",
    "csrf",
    "elyvel",
    "http",
    "middleware",
    "rate-limit",
    "session"
  ],
  "license": "MIT",
  "author": "ufhy",
  "homepage": "https://github.com/ufhy/elyvel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ufhy/elyvel.git",
    "directory": "packages/http"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./stubs/*": "./stubs/*",
    "./config/*": "./config/*"
  },
  "files": [
    "src",
    "config",
    "stubs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@elyvel/cache": "workspace:*",
    "@elyvel/console": "workspace:*",
    "@elyvel/core": "workspace:*",
    "@elyvel/database": "workspace:*",
    "@elyvel/support": "workspace:*",
    "@elyvel/validation": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "elysia": ">=1.4.0"
  }
}
