{
  "name": "{{ name }}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch artisan.ts serve",
    "build": "vite build",
    "build:server": "bun artisan.ts app:build",
    "start": "bun dist/artisan.js serve",
    "dev:assets": "vite",
    "serve": "bun artisan.ts serve",
    "artisan": "bun artisan.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elyvel/auth": "{{ dep_auth }}",
    "@elyvel/broadcasting": "{{ dep_broadcasting }}",
    "@elyvel/cache": "{{ dep_cache }}",
    "@elyvel/concurrency": "{{ dep_concurrency }}",
    "@elyvel/console": "{{ dep_console }}",
    "@elyvel/contracts": "{{ dep_contracts }}",
    "@elyvel/core": "{{ dep_core }}",
    "@elyvel/database": "{{ dep_database }}",
    "@elyvel/encryption": "{{ dep_encryption }}",
    "@elyvel/events": "{{ dep_events }}",
    "@elyvel/hashing": "{{ dep_hashing }}",
    "@elyvel/http": "{{ dep_http }}",
    "@elyvel/http-client": "{{ dep_http-client }}",
    "@elyvel/image": "{{ dep_image }}",
    "@elyvel/log": "{{ dep_log }}",
    "@elyvel/mail": "{{ dep_mail }}",
    "@elyvel/notifications": "{{ dep_notifications }}",
    "@elyvel/process": "{{ dep_process }}",
    "@elyvel/queue": "{{ dep_queue }}",
    "@elyvel/scheduler": "{{ dep_scheduler }}",
    "@elyvel/storage": "{{ dep_storage }}",
    "@elyvel/support": "{{ dep_support }}",
    "@elyvel/testing": "{{ dep_testing }}",
    "@elyvel/translation": "{{ dep_translation }}",
    "@elyvel/validation": "{{ dep_validation }}",
    "@elyvel/view": "{{ dep_view }}",
    "@kitajs/html": "^4.2.13",
    "better-auth": "1.6.27",
    "elysia": "^1.4.29"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
