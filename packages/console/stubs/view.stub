import { Layout } from '{{ layoutImport }}'

export type {{ class }}Props = {
  title: string
}

/**
 * {{ class }} page.
 *
 * Props are checked wherever this is rendered — `view({{ class }}, { title })`
 * will not compile with a missing or misspelled prop.
 */
export function {{ class }}({ title }: {{ class }}Props) {
