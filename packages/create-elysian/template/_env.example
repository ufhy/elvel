APP_NAME="{{ name }}"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_TIMEZONE=UTC

# Empty on purpose. `create-elysian` fills it in, and `artisan key:generate`
# writes one for a checkout that starts from this file.
#
# A shipped default would be a shared secret: it lives in the framework's own
# repository, so every application carrying it can be decrypted by anyone who
# reads the template. Empty fails loudly at boot instead, which is the honest
# failure of the two.
APP_KEY=
# Keys that are no longer primary but can still read what they wrote.
# Comma-separated; set this before running key:generate --force.
APP_PREVIOUS_KEYS=

PORT=3000
HOST=

VIEW_CACHE=false

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_REQUESTS=false

# Read only once @elysian/database is installed and its provider registered —
# see bootstrap/providers.ts. Left here so adding one is not also a hunt for the
# variable names.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

# file works on one machine. database needs: artisan session:table && artisan migrate
SESSION_DRIVER=file
SESSION_CSRF=true
# Encrypt the session cookie instead of only signing it.
SESSION_ENCRYPT=false

# Signs better-auth's tokens. Never reuse APP_KEY: one key for both means a leak
# of either is a leak of both. Filled in by `create-elysian`, or by:
#   artisan auth:secret
#
# Empty is worse than wrong here — better-auth signs with an empty string and
# says nothing — so it is generated rather than defaulted.
# The tables come from: artisan auth:schema && artisan migrate
AUTH_SECRET=
AUTH_MOUNT=true

# file needs no service. database needs: artisan cache:table && artisan migrate
CACHE_STORE=file

# sync runs the job in the request. database needs: artisan queue:table
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null

# log writes the message instead of sending it.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="{{ name }}"

FILESYSTEM_DISK=local

# Only read by the redis cache store and queue connection.
REDIS_URL=redis://127.0.0.1:6379

# Comma-separated origins, or * while nothing is credentialed.
CORS_ORIGINS=*
CORS_CREDENTIALS=false

# Proxies whose X-Forwarded-* headers are believed. Empty = trust none.
TRUSTED_PROXIES=
