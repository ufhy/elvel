{
  "name": "@elvel/auth",
  "version": "1.0.0-alpha.12",
  "description": "Authentication for Elvel — token guard, gate, and better-auth over the framework ORM",
  "keywords": [
    "auth",
    "authentication",
    "authorization",
    "bun",
    "elvel",
    "gate",
    "policy"
  ],
  "license": "MIT",
  "author": "ufhy",
  "homepage": "https://github.com/ufhy/elvel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ufhy/elvel.git",
    "directory": "packages/auth"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config/*": "./config/*"
  },
  "files": [
    "src",
    "config",
    "stubs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@elvel/console": "workspace:*",
    "@elvel/core": "workspace:*",
    "@elvel/database": "workspace:*",
    "@elvel/http": "workspace:*",
    "@elvel/notifications": "workspace:*",
    "@elvel/support": "workspace:*"
  },
  "peerDependencies": {
    "better-auth": ">=1.6.0",
    "elysia": ">=1.4.0"
  },
  "devDependencies": {
    "@elvel/cache": "workspace:*"
  }
}
