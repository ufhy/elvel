{
  "name": "{{ name }}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun elvel.ts dev",
    "build": "vite build",
    "build:server": "bun elvel.ts app:build",
    "start": "bun dist/elvel.js serve",
    "dev:assets": "vite",
    "serve": "bun elvel.ts serve",
    "elvel": "bun elvel.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elvel/auth": "{{ dep_auth }}",
    "@elvel/broadcasting": "{{ dep_broadcasting }}",
    "@elvel/cache": "{{ dep_cache }}",
    "@elvel/client": "{{ dep_client }}",
    "@elvel/concurrency": "{{ dep_concurrency }}",
    "@elvel/console": "{{ dep_console }}",
    "@elvel/contracts": "{{ dep_contracts }}",
    "@elvel/core": "{{ dep_core }}",
    "@elvel/database": "{{ dep_database }}",
    "@elvel/encryption": "{{ dep_encryption }}",
    "@elvel/events": "{{ dep_events }}",
    "@elvel/hashing": "{{ dep_hashing }}",
    "@elvel/http": "{{ dep_http }}",
    "@elvel/http-client": "{{ dep_http-client }}",
    "@elvel/image": "{{ dep_image }}",
    "@elvel/log": "{{ dep_log }}",
    "@elvel/mail": "{{ dep_mail }}",
    "@elvel/notifications": "{{ dep_notifications }}",
    "@elvel/process": "{{ dep_process }}",
    "@elvel/queue": "{{ dep_queue }}",
    "@elvel/scheduler": "{{ dep_scheduler }}",
    "@elvel/storage": "{{ dep_storage }}",
    "@elvel/support": "{{ dep_support }}",
    "@elvel/testing": "{{ dep_testing }}",
    "@elvel/translation": "{{ dep_translation }}",
    "@elvel/validation": "{{ dep_validation }}",
    "@elvel/view": "{{ dep_view }}",
    "@elvel/vite": "{{ dep_vite }}",
    "@kitajs/html": "^4.2.13",
    "better-auth": "1.7.1",
    "elysia": "^1.4.29"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
