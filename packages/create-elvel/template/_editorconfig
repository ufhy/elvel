# https://editorconfig.org — read by every editor worth using, so a checkout
# formats the same way before anybody runs a formatter.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
