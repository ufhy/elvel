{
  "name": "@elvel/lens",
  "version": "1.0.0-alpha.26",
  "description": "Request, query and job recorder for Elvel — a debug dashboard and an inspection bar",
  "keywords": [
    "bun",
    "debug",
    "elvel",
    "monitoring",
    "profiling"
  ],
  "license": "MIT",
  "author": "ufhy",
  "homepage": "https://github.com/ufhy/elvel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ufhy/elvel.git",
    "directory": "packages/lens"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config/*": "./config/*"
  },
  "files": [
    "src",
    "config",
    "stubs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@elvel/console": "workspace:*",
    "@elvel/contracts": "workspace:*",
    "@elvel/core": "workspace:*",
    "@elvel/database": "workspace:*",
    "@elvel/http": "workspace:*",
    "@elvel/log": "workspace:*",
    "@elvel/view": "workspace:*",
    "@kitajs/html": "^4.2.13",
    "elysia": ">=1.4.0"
  },
  "devDependencies": {
    "@elvel/cache": "workspace:*"
  }
}
