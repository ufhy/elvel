node_modules
dist

# Scratch apps: `bun run create apps/<name>` targets, the throwaway project the
# smoke test scaffolds, and a demo scaffolded to look at. playground/ is tracked
# on purpose.
apps/
.smoke-scaffold/
.demo/

*.tsbuildinfo
.DS_Store

.env
.env.local

# bun.lock is committed on purpose so `bun run verify` is reproducible in CI.

# A scaffolded application's database is built, never shipped — and the template
# is somewhere a stray `bun test` can boot an application and leave one behind.
**/database/*.sqlite
**/database/*.sqlite-shm
**/database/*.sqlite-wal
