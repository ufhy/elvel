node_modules
dist

# `scripts/release.ts` puts a LICENSE and a generated README beside each
# package.json for the length of a `bun pm pack`, then removes them. Twenty-six
# copies of each is not something to keep in git.
packages/*/LICENSE
packages/*/README.md
dist-release/

# Scratch apps: `bun run create apps/<name>` targets, the throwaway project the
# smoke test scaffolds, and a demo scaffolded to look at. playground/ is tracked
# on purpose.
apps/
.smoke-scaffold/
.bundle-check/
.demo/

*.tsbuildinfo
.DS_Store

.env
.env.local

# The playground's too. It was committed so CI had one, and it is byte-identical
# to `playground/.env.example` — so the copy is made where it is needed instead,
# and this repository stops contradicting the advice it gives applications.
playground/.env

# bun.lock is committed on purpose so `bun run verify` is reproducible in CI.

# A scaffolded application's database is built, never shipped — and the template
# is somewhere a stray `bun test` can boot an application and leave one behind.
**/database/*.sqlite
**/database/*.sqlite-shm
**/database/*.sqlite-wal

# The smoke run builds one here to migrate from scratch, and SQLite's
# write-ahead log outlives the process that made it.
playground/storage/framework/*.sqlite*
