node_modules
dist

# `scripts/release.ts` puts a LICENSE and a generated README beside each
# package.json for the length of a `bun pm pack`, then removes them. Twenty-six
# copies of each is not something to keep in git.
packages/*/LICENSE
packages/*/README.md
dist-release/

# Scratch apps: `bun run create apps/<name>` targets, the throwaway project the
# smoke test scaffolds, and a demo scaffolded to look at. playground/ is tracked
# on purpose.
#
# `apps/*` rather than `apps/`, because git does not descend into an excluded
# directory and the negation below would never be read. `apps/docs` is the
# documentation site and is tracked.
apps/*
!apps/docs
.bundle-check/
.demo/
.demo-online/

# Where `packages/auth/test/dialects.test.ts` writes a generated migration so it
# can be imported with real module resolution. Removed by the test; ignored in
# case a run is killed part way through.
packages/*/test/.generated-*

*.tsbuildinfo
.DS_Store

# What the Playwright MCP server leaves behind when a page is opened to look at.
.playwright-mcp/

# Editor and agent configuration, which is a matter of taste rather than of the
# framework. A language server declared here can only be declared inside a
# plugin, and the only project-scoped plugin form Claude Code has is a directory
# under `.claude/skills` — so it lands in the repository whether or not the
# repository wants it. Whoever wants one makes it; nobody inherits it.
.claude/

.env
.env.local

# The playground's too. It was committed so CI had one, and it is byte-identical
# to `playground/.env.example` — so the copy is made where it is needed instead,
# and this repository stops contradicting the advice it gives applications.
playground/.env

# bun.lock is committed on purpose so `bun run verify` is reproducible in CI.

# A scaffolded application's database is built, never shipped — and the template
# is somewhere a stray `bun test` can boot an application and leave one behind.
**/database/*.sqlite
**/database/*.sqlite-shm
**/database/*.sqlite-wal

# The smoke run builds one here to migrate from scratch, and SQLite's
# write-ahead log outlives the process that made it.
playground/storage/framework/*.sqlite*

# The documentation site's build output and its cache. `dist` above already
# covers `.vitepress/dist`; the cache is separate and large.
apps/docs/.vitepress/cache/
