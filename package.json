{
  "name": "elysian",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "playground",
    "apps/*"
  ],
  "scripts": {
    "create": "bun packages/create-elysian/src/index.ts",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "bun scripts/smoke.ts",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run smoke",
    "playground": "bun playground/artisan.ts",
    "playground:dev": "bun --watch playground/artisan.ts serve",
    "playground:reset": "bun scripts/reset-playground.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@clack/prompts": "^1.7.0",
    "@elysiajs/static": "^1.4.10",
    "@elysian/auth": "workspace:*",
    "@elysian/broadcasting": "workspace:*",
    "@elysian/cache": "workspace:*",
    "@elysian/console": "workspace:*",
    "@elysian/contracts": "workspace:*",
    "@elysian/core": "workspace:*",
    "@elysian/database": "workspace:*",
    "@elysian/encryption": "workspace:*",
    "@elysian/events": "workspace:*",
    "@elysian/hashing": "workspace:*",
    "@elysian/http": "workspace:*",
    "@elysian/log": "workspace:*",
    "@elysian/mail": "workspace:*",
    "@elysian/notifications": "workspace:*",
    "@elysian/process": "workspace:*",
    "@elysian/queue": "workspace:*",
    "@elysian/scheduler": "workspace:*",
    "@elysian/storage": "workspace:*",
    "@elysian/support": "workspace:*",
    "@elysian/testing": "workspace:*",
    "@elysian/translation": "workspace:*",
    "@elysian/validation": "workspace:*",
    "@elysian/view": "workspace:*",
    "@kitajs/html": "^4.2.13",
    "@types/bun": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "elysia": "^1.4.29",
    "picocolors": "^1.1.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "better-auth": "1.6.27",
    "nodemailer": "9.0.5"
  }
}
