{
  "name": "elyvel",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "playground",
    "apps/*"
  ],
  "scripts": {
    "create": "bun packages/create-elyvel/src/index.ts",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "bun scripts/smoke.ts",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run smoke",
    "playground": "bun playground/artisan.ts",
    "playground:dev": "bun --watch playground/artisan.ts serve",
    "playground:reset": "bun scripts/reset-playground.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@clack/prompts": "^1.7.0",
    "@elysiajs/static": "^1.4.10",
    "@elyvel/auth": "workspace:*",
    "@elyvel/broadcasting": "workspace:*",
    "@elyvel/cache": "workspace:*",
    "@elyvel/concurrency": "workspace:*",
    "@elyvel/console": "workspace:*",
    "@elyvel/contracts": "workspace:*",
    "@elyvel/core": "workspace:*",
    "@elyvel/database": "workspace:*",
    "@elyvel/encryption": "workspace:*",
    "@elyvel/events": "workspace:*",
    "@elyvel/hashing": "workspace:*",
    "@elyvel/http": "workspace:*",
    "@elyvel/http-client": "workspace:*",
    "@elyvel/image": "workspace:*",
    "@elyvel/log": "workspace:*",
    "@elyvel/mail": "workspace:*",
    "@elyvel/notifications": "workspace:*",
    "@elyvel/process": "workspace:*",
    "@elyvel/queue": "workspace:*",
    "@elyvel/scheduler": "workspace:*",
    "@elyvel/storage": "workspace:*",
    "@elyvel/support": "workspace:*",
    "@elyvel/testing": "workspace:*",
    "@elyvel/translation": "workspace:*",
    "@elyvel/validation": "workspace:*",
    "@elyvel/view": "workspace:*",
    "@kitajs/html": "^4.2.13",
    "@types/bun": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "elysia": "^1.4.29",
    "picocolors": "^1.1.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "better-auth": "1.6.27",
    "nodemailer": "9.0.5"
  },
  "version": "1.0.0-alpha.1",
  "license": "MIT",
  "description": "Elyvel — a Laravel-shaped framework for Bun, built on Elysia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ufhy/elyvel.git"
  }
}
